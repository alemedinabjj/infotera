{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{ts,tsx,mts,mjs,css,json,jsonc}",
      "!mock-api",
      "!.claude",
      "!**/.next",
      "!**/node_modules",
      "!playwright-report",
      "!test-results",
      "!coverage",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "noNonNullAssertion": "error",
        "noEnum": "error",
        "noDefaultExport": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 250,
            "skipBlankLines": true
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80,
            "skipBlankLines": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/**/{page,layout,loading,error,global-error,not-found,template,default,route,opengraph-image,twitter-image,icon,apple-icon,sitemap,robots,manifest,forbidden,unauthorized}.{ts,tsx}",
        "*.config.{ts,mts,mjs}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features",
                      "@/features/**",
                      "@/app",
                      "@/app/**",
                      "../**/features/**",
                      "../**/app/**"
                    ],
                    "message": "shared n\u00e3o importa features nem app (app \u2192 features \u2192 shared)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features", "@/features/**", "@/app", "@/app/**"],
                    "message": "Feature n\u00e3o importa outra feature nem app; dentro da feature use import relativo."
                  },
                  {
                    "group": [
                      "**/{search-form,hotel-search,hotel-details,checkout,booking-confirmation}/**"
                    ],
                    "message": "Feature n\u00e3o importa outra feature (nem por caminho relativo)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "app importa features s\u00f3 pelo index.ts (@/features/<nome>)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.{ts,tsx}", "e2e/**", "tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": {
                    "importNames": ["test"],
                    "message": "Importe `test` de e2e/fixtures.ts: ele intercepta os tiles do OSM (crit\u00e9rio 47)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["e2e/fixtures.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
